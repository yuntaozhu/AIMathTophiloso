# GEMINI_API_KEY: Required for Gemini AI API calls (direct Google GenAI SDK).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: Vercel AI Gateway — when set, preferred for routed / observed model calls.
# Create key in Vercel Dashboard → AI Gateway, or use OIDC via `vercel env pull`.
# AI_GATEWAY_API_KEY=""
# AI_GATEWAY_MODEL="google/gemini-2.5-flash"

# APP_URL: Public URL of this seminar app (Vercel production / preview domain).
APP_URL="https://ai-math-tophiloso.vercel.app"

# DOUBAO_API_KEY: Optional ByteDance Doubao / Volcengine Ark (Agenda Guardian).
# If empty, agenda guardian falls back to Gemini then offline_fallback.
DOUBAO_API_KEY=""
DOUBAO_API_KEY_ID=""
DOUBAO_MODEL_ENDPOINT="doubao-pro-32k"

# Optional: Firecrawl (search/scrape for literature PDF ingest scripts)
# FIRECRAWL_API_KEY=""

# Without Redis, in-memory sync works on a single Fluid instance (fine for small seminars).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
